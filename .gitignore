# Netlify CLI / build system state — generated, machine-specific, never commit.
# These are recreated on every `netlify` invocation and deploy. A stale committed
# copy of .netlify/plugins (the extension-managed build plugin cache) or of the
# resolved .netlify/netlify.toml can conflict with config/extension resolution.
# NOTE: intentionally scoped rather than ignoring all of `.netlify/`.
.netlify/netlify.toml
.netlify/state.json
.netlify/plugins/
.netlify/functions/
.netlify/functions-serve/
.netlify/functions-internal/
.netlify/edge-functions/
.netlify/edge-functions-dist/
.netlify/blobs/
.netlify/blobs-serve/
.netlify/build/
.netlify/cache/
.netlify/deploy/

# Build output
dist/
.astro/

# Dependencies
node_modules/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment
.env
.env.local
.env.*.local

# Editor
.vscode/
.idea/
.DS_Store
*.swp

# macOS
.DS_Store

# Optional npm cache directory
.npm

# Playwright
test-results/
playwright-report/

# Mobile audit output — keep findings.md, drop screenshots/json
_mobile-audit/**
!_mobile-audit/**/findings.md
!_mobile-audit/**/reports.json

# Core Web Vitals audit output (timestamped runs)
_cwv-audit/**

# Rendered served text, written by scripts/dump-served-text.mjs for the prose gate and the
# lexical sweeps. Generated on demand and never committed: it is a measurement target, and a
# committed copy would be the stale one the next session reads.
.served-text/
